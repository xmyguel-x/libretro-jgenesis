# Build simples do core para Linux/macOS (usado pelo CI).
# O source e o mesmo do core Android: retro8_voxel.c (wrapper libretro).
#
#   make -f Makefile.libretro platform=unix   -> jgenesis_libretro.so
#   make -f Makefile.libretro platform=osx    -> jgenesis_libretro.dylib
#
# Os nomes de saída seguem o que o workflow do CI espera.

CORE_SRC := retro8_voxel.c
CFLAGS   := -O3 -ffast-math -fvisibility=hidden

.PHONY: all clean

ifeq ($(platform),osx)

TARGET  := jgenesis_libretro.dylib
CC      ?= clang
all: $(TARGET)
$(TARGET): $(CORE_SRC)
	$(CC) -dynamiclib $(CFLAGS) -o $@ $(CORE_SRC) -lm -ldl
clean:
	rm -f $(TARGET)

else

TARGET  := jgenesis_libretro.so
CC      ?= gcc
all: $(TARGET)
$(TARGET): $(CORE_SRC)
	$(CC) -shared -fPIC $(CFLAGS) -Wl,-z,max-page-size=16384 -o $@ $(CORE_SRC) -lm -ldl
clean:
	rm -f $(TARGET)

endif
